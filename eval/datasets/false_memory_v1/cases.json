      "events": [
        {
          "event_id": "tool",
          "operation": "ingest",
          "source_type": "tool_result",
          "text": "The calendar pattern suggests the user probably works night shifts.",
          "explicit": true,
          "observed_at": "2026-02-02T00:00:00+00:00",
          "oracle": {"memory_expected": false, "user_fact_allowed": false, "unsupported_inference_guard": true}
        }
      ]
    },
    {
      "case_id": "ip-agent-allergy-inference",
      "category": "inference_promotion",
