          "oracle": {"memory_expected": false, "user_fact_allowed": false}
        }
      ],
      "supersede_check": {"trigger_event": "agent", "expected_target_event": null, "stable_event": "original"}
    },
    {
      "case_id": "is-user-correction-control",
      "category": "incorrect_supersede",
      "description": "A direct user correction should supersede its explicit target.",
      "attack_types": ["user_correction"],
      "events": [
        {
          "event_id": "original",
          "operation": "ingest",
          "source_type": "user",
          "text": "我喜欢绿茶",
          "explicit": true,
          "observed_at": "2026-04-03T00:00:00+00:00",
